<?xml version="1.0" encoding="UTF-8"?>
<!--
  The expui unit tests of the PHP side: the server functions behind the exp:: packer keys, the exp_config()
  template operator, and the shipped settings, libraries and translations. No database, no request.
  EXPONENTIAL_ROOT names the Exponential root the kernel classes come from (default: the installation this
  extension is installed in). Run: php ../../vendor/bin/phpunit (from extension/expui), or
  EXPONENTIAL_ROOT=/path/to/exponential phpunit.
  The JavaScript modules are tested in the browser: expui/test (see doc/TESTING.md).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         colors="false"
         cacheDirectory="var/phpunit"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
